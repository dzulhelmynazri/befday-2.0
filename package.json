{
  "name": "befday-2.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "@types/node": "^26.6.6",
      "varlock": "1.24.0",
      "lucide-react": "^1.70.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "@prisma/client": "^7.10.1",
      "prisma": "~7.10.1",
      "@prisma/adapter-neon": "~7.10.1",
      "@trpc/server": "^11.25.0",
      "@trpc/client": "^11.25.0",
      "@trpc/tanstack-react-query": "^11.25.0",
      "@tanstack/react-query": "^5.107.1",
      "@tanstack/react-query-devtools": "^5.107.1",
      "better-auth": "1.7.18",
      "@tanstack/react-form": "^1.33.5",
      "@tailwindcss/postcss": "^4.3.5",
      "tailwindcss": "^4.3.5",
      "@better-auth/expo": "1.7.18",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "typescript": "^7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --",
    "dev:agent": "turbo run dev -F agent --",
    "eval:agent": "turbo run eval -F agent --",
    "workflow:web": "turbo run workflow:web -F web --",
    "db:push": "turbo run db:push -F @befday-2.0/db --",
    "db:studio": "turbo run db:studio -F @befday-2.0/db --",
    "db:generate": "turbo run db:generate -F @befday-2.0/db --",
    "db:migrate": "turbo run db:migrate -F @befday-2.0/db --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@befday-2.0/config": "workspace:*",
    "@gdp-ts/core": "^0.1.0",
    "@shadcn/lint": "^0.2.5",
    "@types/node": "catalog:",
    "lefthook": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "shadcn": "^4.23.0",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "ultracite": "8.1.1",
    "varlock": "catalog:"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@^2.0.0"
  },
  "packageManager": "bun@1.4.2"
}
