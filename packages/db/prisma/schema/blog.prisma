enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  description   String
  content       String     @db.Text
  coverImageUrl String
  tags          String[]   @default([])
  status        BlogStatus @default(DRAFT)
  publishedAt   DateTime   @default(now())

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@map("blog_post")
}

